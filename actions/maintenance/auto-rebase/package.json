{
  "name": "actions-maintenance-auto-rebase",
  "version": "1.0.0",
  "description": "Update every open pull request carrying a label with its base branch",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "build": "bun run ../../../scripts/build-action.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "actions-util": "workspace:*"
  },
  "devDependencies": {
    "actions-e2e": "workspace:*",
    "@fast-check/vitest": "0.5.0",
    "@types/node": "26.6.6",
    "fast-check": "4.10.2",
    "@typescript/native": "npm:typescript@7.0.2",
    "vitest": "5.1.0"
  }
}
