{
  "name": "actions-helm-apply-chart-updates",
  "version": "1.0.0",
  "description": "Apply templated multi-image updates to a Helm chart's values.yaml and Chart.yaml",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "build": "bun run ../../../scripts/build-action.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "actions-util": "workspace:*",
    "@actions/core": "3.0.1"
  },
  "devDependencies": {
    "actions-e2e": "workspace:*",
    "@fast-check/vitest": "0.5.0",
    "@types/node": "26.6.3",
    "fast-check": "4.10.1",
    "@typescript/native": "npm:typescript@7.0.2",
    "vitest": "5.0.2",
    "yaml": "2.9.1"
  }
}
