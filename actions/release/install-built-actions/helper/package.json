{
  "name": "actions-release-install-built-actions-helper",
  "version": "1.0.0",
  "description": "Internal helper of actions/release/install-built-actions: verifies a build-actions artifact and installs its bundles.",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "build": "bun run ../../../../scripts/build-action.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "action-graph": "workspace:*",
    "actions-util": "workspace:*"
  },
  "devDependencies": {
    "actions-e2e": "workspace:*",
    "@types/node": "26.6.6",
    "@typescript/native": "npm:typescript@7.0.2",
    "vitest": "5.1.0"
  }
}
