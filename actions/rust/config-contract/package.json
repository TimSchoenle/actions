{
  "name": "actions-rust-config-contract",
  "version": "1.0.0",
  "description": "Check a terrace-config contract, its Dockerfile LABEL block and a built image against the types they describe",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "build": "bun run ../../../scripts/build-action.ts",
