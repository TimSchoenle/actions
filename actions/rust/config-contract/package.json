    "@actions/exec": "3.0.0"
  },
  "devDependencies": {
    "actions-e2e": "workspace:*",
    "@fast-check/vitest": "0.4.1",
    "@types/node": "26.2.0",
    "fast-check": "4.9.0",
    "typescript": "6.0.3",
    "vitest": "4.1.11"
  }
}
