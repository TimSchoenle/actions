{
  "extends": "../../../tsconfig.json",
  "compilerOptions": {
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "outDir": "dist",
    // `handlebars` is CommonJS and declares itself with `export =`, which an ES module can only
    // default-import through the interop shim. The bundler emits that shim regardless; this is what
    // lets the compiler agree with it.
    "esModuleInterop": true
  },
  "include": ["src/**/*", "e2e/**/*"],
  "exclude": ["node_modules", "dist"]
}
