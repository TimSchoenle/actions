{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "description": "Default configuration for Renovate",
  "extends": [
    "config:best-practices",
    "helpers:pinGitHubActionDigests",
    "workarounds:all",
    "github>TimSchoenle/actions//configs/renovate/base",
    "github>TimSchoenle/actions//configs/renovate/ci-automerge"
  ],
  "dependencyDashboardApproval": false,
  "dependencyDashboard": true,
  "semanticCommits": "enabled",
  "semanticCommitType": "deps",
  "labels": ["dependencies"],
  "rebaseWhen": "behind-base-branch",
  "prCreation": "immediate",
  "timezone": "Europe/Berlin",
  "minimumReleaseAge": "3 days",
  "ignoreUnstable": true,
  "respectLatest": true,
  "separateMajorMinor": true,
  "separateMinorPatch": true,
  "rollbackPrs": true,
  "platformAutomerge": true,
  "automergeType": "pr",
  "assigneesFromCodeOwners": true,
  "reviewersFromCodeOwners": true,
  "vulnerabilityAlerts": {
    "enabled": true,
    "labels": ["dependencies", "security", "vulnerability"],
    "automerge": true,
    "dependencyDashboardApproval": false,
    "prCreation": "immediate"
  },
  "lockFileMaintenance": {
    "enabled": true,
    "schedule": ["before 4am on monday"],
    "automerge": true
  },
  "dependencyDashboardOSVVulnerabilitySummary": "all",
  "osvVulnerabilityAlerts": true,
  "commitHourlyLimit": 0,
  "prHourlyLimit": 2,
  "prConcurrentLimit": 0,
  "branchConcurrentLimit": 0,
  "gitIgnoredAuthors": [
    "actions-maintenance-bot",
    "actions-maintenance-bot[bot]@users.noreply.github.com",
    "253958393+actions-maintenance-bot[bot]@users.noreply.github.com"
  ],
  "packageRules": [
    {
      "description": "Auto-merge all non-major updates",
      "matchUpdateTypes": ["minor", "patch", "digest", "pin", "lockFileMaintenance"],
      "automerge": true
    },
    {
      "description": "Disable dependency dashboard approval for all packages",
      "matchPackageNames": ["*"],
      "dependencyDashboardApproval": false
    },
    {
      "description": "Group all minor and patch updates for GitHub Actions outside .github/, such as the action.yml of a published action. Updates under .github/ are taken over by the CI rules below.",
      "matchManagers": ["github-actions"],
      "matchUpdateTypes": ["minor", "patch"],
      "groupName": "all non-major action updates"
    },
    {
      "description": "terrace-config and terrace-legal: one PR for every update of either, whatever its type. Cargo git dependencies on GitHub resolve to packageName `TimSchoenle/<repo>` (older Renovate: the full git URL), never to the crate name, and JitPack publishes the Java modules under `com.github.TimSchoenle.<repo>`.",
      "matchPackageNames": [
        "/^(?:https://github\\.com/)?TimSchoenle/terrace-(?:config|legal)(?:\\.git)?$/i",
        "/^com\\.github\\.TimSchoenle\\.terrace-(?:config|legal):/i"
      ],
      "groupName": "terrace-config and terrace-legal",
      "groupSlug": "terrace",
      "separateMajorMinor": false,
      "separateMultipleMajor": false,
      "separateMinorPatch": false
    },
    {
      "description": "Everything under .github/ is CI and never ships: commit it as ci(deps), a type release-please hides, so a CI update never cuts a release. Matches by file rather than manager, which covers the github-actions manager, the regex manager for TimSchoenle/actions pins and customManagers:githubActionsVersions alike. separateMinorPatch: false lives here because Renovate refuses it next to matchUpdateTypes; it keeps patch and minor updates on one branch instead of a patch- prefixed second one.",
      "matchFileNames": [".github/**"],
      "semanticCommitType": "ci",
      "separateMinorPatch": false
    },
    {
      "description": "One PR for every non-major CI update, across all managers. Majors stay outside the group so they arrive alone and are not auto-merged.",
      "matchFileNames": [".github/**"],
      "matchUpdateTypes": ["minor", "patch", "digest", "pin", "pinDigest"],
      "groupName": "ci dependencies",
      "groupSlug": "ci"
    }
  ]
}
