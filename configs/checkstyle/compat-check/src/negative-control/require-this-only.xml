<?xml version="1.0"?>
<!DOCTYPE module PUBLIC
        "-//Checkstyle//DTD Checkstyle Configuration 1.3//EN"
        "https://checkstyle.org/dtds/configuration_1_3.dtd">

<!--
  Deliberately just RequireThis, with none of the two rulesets' Lombok-aware suppressions. Proves
  the shared/lombok fixture actually triggers a violation when unsuppressed, so the "suppressed"
  assertion in compat-check/build.gradle.kts isn't vacuously true against a fixture nothing flags.
-->
<module name="Checker">
    <module name="TreeWalker">
        <module name="RequireThis">
            <property name="validateOnlyOverlapping" value="false"/>
        </module>
    </module>
</module>
