{
  "name": "actions-util",
  "version": "1.0.0",
  "description": "Shared TypeScript utilities for GitHub Actions",
  "type": "module",
  "main": "dist/index.js",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./core": {
      "types": "./dist/core.d.ts",
      "import": "./dist/core.js"
    },
    "./octokit": {
      "types": "./dist/octokit.d.ts",
      "import": "./dist/octokit.js"
    },
    "./yaml": {
      "types": "./dist/yaml-index.d.ts",
      "import": "./dist/yaml-index.js"
    },
    "./branches": {
      "types": "./dist/github-branches.d.ts",
      "import": "./dist/github-branches.js"
    },
    "./identity": {
      "types": "./dist/github-identity.d.ts",
      "import": "./dist/github-identity.js"
    },
    "./commits": {
      "types": "./dist/github-commits.d.ts",
      "import": "./dist/github-commits.js"
    },
    "./client": {
      "types": "./dist/github-client.d.ts",
      "import": "./dist/github-client.js"
    },
    "./commit-on-branch": {
      "types": "./dist/github-commit-on-branch.d.ts",
      "import": "./dist/github-commit-on-branch.js"
    },
    "./patch": {
      "types": "./dist/patch.d.ts",
      "import": "./dist/patch.js"
    },
    "./patch-reader": {
      "types": "./dist/patch-reader.d.ts",
      "import": "./dist/patch-reader.js"
    },
    "./read-after-write": {
      "types": "./dist/read-after-write.d.ts",
      "import": "./dist/read-after-write.js"
    },
    "./release-download": {
      "types": "./dist/release-download.d.ts",
      "import": "./dist/release-download.js"
    }
  },
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@octokit/core": "7.0.8",
    "@octokit/plugin-paginate-rest": "14.0.0",
    "@octokit/plugin-rest-endpoint-methods": "17.0.0",
    "yaml": "2.9.1"
  },
  "devDependencies": {
    "@fast-check/vitest": "0.5.0",
    "@types/node": "26.6.6",
    "@typescript/native": "npm:typescript@7.0.2",
    "fast-check": "4.10.2",
    "vitest": "5.1.0"
  }
}
