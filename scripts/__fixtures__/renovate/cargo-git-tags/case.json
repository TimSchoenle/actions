{
  "description": "Cargo git dependencies pinned by monorepo and plain release tags resolve, stay on their own component and keep their group.",
  "presets": ["default"],
  "files": {
    "Cargo.toml": "Cargo.toml"
  },
  "dependencies": [
    {
      "manager": "cargo",
      "depName": "csp-shell",
      "minUpdates": 1,
      "newValue": "^csp-shell-v\\d+\\.\\d+\\.\\d+$"
    },
    {
      "manager": "cargo",
      "depName": "terrace-config",
      "minUpdates": 1,
      "newValue": "^v\\d+\\.\\d+\\.\\d+$",
      "branchName": "renovate/terrace"
    }
  ]
}
