{
  "description": "`rust-version` in Cargo.toml is extracted, keeps its major.minor form and joins the rust toolchain group.",
  "presets": ["default", "rust-application"],
  "files": {
    "Cargo.toml": "Cargo.toml"
  },
  "dependencies": [
    {
      "manager": "regex",
      "depName": "rust",
      "packageFile": "Cargo.toml",
      "minUpdates": 1,
      "newValue": "^\\d+\\.\\d+$",
      "branchName": "renovate/rust-toolchain"
    }
  ]
}
