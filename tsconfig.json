{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ESNext"],
    "types": ["bun", "vitest"],
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "strict": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "verbatimModuleSyntax": true,
    "resolveJsonModule": true,
    "rootDir": ".",
    "paths": {
      "actions-util": ["./packages/ts-util/src/index.ts"],
      "actions-util/core": ["./packages/ts-util/src/core.ts"],
      "actions-util/branches": ["./packages/ts-util/src/github-branches.ts"],
      "actions-util/identity": ["./packages/ts-util/src/github-identity.ts"],
      "actions-util/commits": ["./packages/ts-util/src/github-commits.ts"],
      "actions-util/client": ["./packages/ts-util/src/github-client.ts"],
      "actions-util/commit-on-branch": ["./packages/ts-util/src/github-commit-on-branch.ts"],
      "actions-util/patch": ["./packages/ts-util/src/patch.ts"],
      "actions-util/patch-reader": ["./packages/ts-util/src/patch-reader.ts"],
      "actions-util/read-after-write": ["./packages/ts-util/src/read-after-write.ts"],
      "actions-util/release-download": ["./packages/ts-util/src/release-download.ts"],
      "actions-e2e": ["./packages/e2e/src/index.ts"],
      "action-graph": ["./packages/action-graph/src/index.ts"]
    }
  },
  "include": ["scripts/**/*", "actions/**/*", "packages/**/*"],
  "exclude": ["node_modules", "configs"]
}
