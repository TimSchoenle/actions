# Global defaults
* text=auto eol=lf working-tree-encoding=UTF-8

# Windows scripts
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf
*.psm1 text eol=crlf
*.psd1 text eol=crlf

# Shell scripts
*.sh text eol=lf diff=bash
*.bash text eol=lf diff=bash
*.zsh text eol=lf diff=bash
.husky/* text eol=lf linguist-language=Shell
.husky/pre-commit text eol=lf linguist-language=Shell

# Source code & formatting
*.ts text eol=lf whitespace=blank-at-eol,blank-at-eof,tab-in-indent
*.tsx text eol=lf whitespace=blank-at-eol,blank-at-eof,tab-in-indent
*.js text eol=lf whitespace=blank-at-eol,blank-at-eof,tab-in-indent
*.mjs text eol=lf whitespace=blank-at-eol,blank-at-eof,tab-in-indent
*.cjs text eol=lf whitespace=blank-at-eol,blank-at-eof,tab-in-indent
*.jsx text eol=lf whitespace=blank-at-eol,blank-at-eof,tab-in-indent
*.d.ts text eol=lf
*.rs text eol=lf diff=rust
*.java text eol=lf diff=java
*.go text eol=lf diff=golang
*.py text eol=lf diff=python
*.css text eol=lf diff=css
*.scss text eol=lf diff=css
*.less text eol=lf diff=css
*.html text eol=lf diff=html
*.xml text eol=lf
*.svg text eol=lf
*.graphql text eol=lf
*.gql text eol=lf
*.sql text eol=lf

# Configuration & data formats
*.json text eol=lf
*.json5 text eol=lf
*.jsonc text eol=lf
*.yaml text eol=lf
*.yml text eol=lf
*.toml text eol=lf
*.ini text eol=lf
.editorconfig text eol=lf linguist-language=INI
.lintstagedrc text eol=lf linguist-language=JSON
.oxfmtrc.json text eol=lf linguist-language=JSON
.release-please-manifest.json text eol=lf linguist-language=JSON
release-please-config.json text eol=lf linguist-language=JSON
renovate.json text eol=lf linguist-language=JSON
configs/renovate/*.json text eol=lf linguist-language=JSON
configs/github-rulesets/*.json text eol=lf linguist-language=JSON
.bun-version text eol=lf linguist-language=Text

# GitHub Actions & Workflows
.github/workflows/*.yaml text eol=lf linguist-language=GitHub-Actions
.github/workflows/*.yml text eol=lf linguist-language=GitHub-Actions
workflows/**/workflow.yaml text eol=lf linguist-language=GitHub-Actions
actions/**/action.yaml text eol=lf linguist-language=YAML
actions/**/action.yml text eol=lf linguist-language=YAML

# Documentation & Prose
*.md text eol=lf diff=markdown linguist-documentation
*.mdx text eol=lf diff=markdown linguist-documentation
*.txt text eol=lf linguist-documentation
LICENSE text eol=lf linguist-documentation
SECURITY.md text eol=lf linguist-documentation
CONTRIBUTING.md text eol=lf linguist-documentation
README.md text eol=lf linguist-documentation
docs/** text eol=lf linguist-documentation
**/CHANGELOG.md text eol=lf linguist-documentation
**/README.md text eol=lf linguist-documentation

# Templates
*.hbs text eol=lf linguist-language=Handlebars
*.handlebars text eol=lf linguist-language=Handlebars
docs/readme/TEMPLATE.md.hbs text eol=lf linguist-language=Handlebars linguist-documentation
scripts/templates/** linguist-documentation
scripts/templates/action/action.yaml text eol=lf linguist-language=YAML
scripts/templates/action/verify-workflow.yaml text eol=lf linguist-language=GitHub-Actions
scripts/templates/workflow/workflow.yaml text eol=lf linguist-language=GitHub-Actions
scripts/templates/workflow/verify-workflow.yaml text eol=lf linguist-language=GitHub-Actions

# Generated files & Bundles
*.map -diff linguist-generated
*.d.ts.map -diff linguist-generated
*.min.js -diff linguist-generated
*.min.css -diff linguist-generated
actions/**/dist/** -diff linguist-generated
actions/**/dist/index.js -diff linguist-generated
packages/**/dist/** -diff linguist-generated
actions/**/src/generated/** linguist-generated
dist/** -diff linguist-generated
build/** -diff linguist-generated
out/** -diff linguist-generated
.next/** -diff linguist-generated
coverage/** -diff linguist-generated
tmp/** -diff linguist-generated

# Lockfiles
bun.lock text eol=lf -diff linguist-generated
bun.lockb binary -diff linguist-generated
package-lock.json text eol=lf -diff linguist-generated
yarn.lock text eol=lf -diff linguist-generated
pnpm-lock.yaml text eol=lf -diff linguist-generated

# Tests, Fixtures & Mocks
**/*.test.ts linguist-detectable=false
**/*.test.js linguist-detectable=false
**/*.test.mjs linguist-detectable=false
**/*.spec.ts linguist-detectable=false
**/*.spec.js linguist-detectable=false
**/*.fuzz.test.ts linguist-detectable=false
**/*.e2e.test.ts linguist-detectable=false
**/__tests__/** linguist-detectable=false
**/__mocks__/** linguist-detectable=false
**/__fixtures__/** linguist-detectable=false
packages/e2e/** linguist-detectable=false
scripts/** linguist-detectable=false

# Vendored & External dependencies
vendor/** linguist-vendored
node_modules/** linguist-vendored
public/**/vendor/** linguist-vendored

